# ==============================================================================
# DETUNNEL (DE Department) - Environment Configuration Template
# Copy this file to '.env' and customize for your local setup.
# ==============================================================================

# Safe defaults. Use 1 only on a deliberately trusted, isolated deployment.
DETUNNEL_PROFILE=balanced
DETUNNEL_FULL_BYPASS=0
DETUNNEL_UNRESTRICTED=0
# Disable browser/CDP and desktop UI automation by default in the MCP runtime.
DETUNNEL_DISABLE_BROWSER_AUTOMATION=1

# MCP HTTP Server Port (Default: 18765)
DETUNNEL_PORT=18765

# Container bind address. Docker Compose publishes it on host localhost only.
DETUNNEL_HOST=0.0.0.0

# Workspace directory path (Folder where AI will read/write code)
# In Docker, this maps to the container's /workspace mount
DETUNNEL_WORKSPACE=/workspace

# Data directory for SQLite databases, logs, and audit trails
# In Docker: /root/.detunnel
# On Windows: C:\Users\<Username>\AppData\Roaming\lnwjud (legacy-compatible default)
DETUNNEL_DATA_PATH=/root/.detunnel

# Run the official OpenAI tunnel-client on the host and point it to
# http://127.0.0.1:18765/mcp. The tunnel-client is intentionally not bundled
# into this image.

# Node Environment
NODE_ENV=production
