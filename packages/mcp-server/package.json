{
  "name": "@detunnel/mcp-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@detunnel/application": "workspace:*",
    "@detunnel/audit": "workspace:*",
    "@detunnel/capabilities": "workspace:*",
    "@detunnel/domain": "workspace:*",
    "@detunnel/extensions": "workspace:*",
    "@detunnel/permissions": "workspace:*",
    "@detunnel/search": "workspace:*",
    "@detunnel/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "scripts": {
    "test": "corepack pnpm@10.15.0 --filter @detunnel/domain build && corepack pnpm@10.15.0 --filter @detunnel/shared build && corepack pnpm@10.15.0 --filter @detunnel/process build && corepack pnpm@10.15.0 --filter @detunnel/capabilities build && corepack pnpm@10.15.0 --filter @detunnel/extensions build && corepack pnpm@10.15.0 build && vitest run",
